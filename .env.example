# Copy to .env and adjust for your machine.

# Prisma / SQLite. Use an absolute path so both Next.js and Prisma CLI agree.
DATABASE_URL="file:./db/custom.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Realtime mini-service (socket.io) used by server-side broadcast helpers
REALTIME_URL="http://localhost:3003"

# Shared secret between the Next.js app and the realtime service. It signs the
# short-lived socket tokens handed to browsers and authenticates app-to-service
# broadcasts. Falls back to NEXTAUTH_SECRET; set it explicitly in production.
REALTIME_SECRET="change-me-in-production"

# Base URL the realtime service uses to reach the app's internal authorization
# endpoint. Defaults to NEXTAUTH_URL.
APP_INTERNAL_URL="http://localhost:3000"

# Development-only additive sample content (POST /api/dev/fixtures).
# Ignored by production builds.
ENABLE_DEV_FIXTURES="true"
