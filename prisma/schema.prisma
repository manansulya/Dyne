model DMReadReceipt {
  id              String   @id @default(cuid())
  directMessageId String
  directMessage   DirectMessage @relation(onDelete: Cascade, fields: [directMessageId], references: [id])
  userId          String
  user            User     @relation(onDelete: Cascade, fields: [userId], references: [id])
